@import "tailwindcss";

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172033;
  background: #f8fbff;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  width: 100%;
  min-height: 100%;
}

body {
  min-width: 320px;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(70, 154, 255, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(110, 196, 255, 0.09),
      transparent 30%
    ),
    #f8fbff;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  width: 100%;
}

/* =================================
   HOME
   ================================= */

.home {
  position: relative;

  min-height: 100vh;

  padding: 32px 24px 120px;

  overflow: hidden;
}

.home::before {
  content: "";

  position: absolute;

  width: 460px;
  height: 460px;

  right: -250px;
  bottom: -150px;

  border-radius: 50%;

  background: rgba(69, 150, 255, 0.06);

  pointer-events: none;
}

.home-header {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 760px;

  margin: 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand h1 {
  margin: 0;

  font-size: 27px;
  font-weight: 750;

  letter-spacing: -1.1px;

  color: #172033;
}

.brand h1 span {
  color: #2679ed;
}

.header-action {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #e3ebf5;
  border-radius: 13px;

  background: rgba(255, 255, 255, 0.9);

  color: #536276;

  box-shadow: 0 5px 18px rgba(40, 85, 130, 0.06);
}

.hero-search {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 660px;

  margin: 90px auto 0;
}

.eyebrow {
  margin: 0 0 13px;

  font-size: 11px;
  font-weight: 750;

  letter-spacing: 1.7px;

  color: #5e93d9;
}

.hero-search h2 {
  margin: 0;

  font-size: clamp(34px, 7vw, 48px);

  font-weight: 720;

  letter-spacing: -2px;

  color: #182235;
}

.hero-search h2 span {
  color: #2679ed;
}

.hero-description {
  margin: 13px 0 30px;

  font-size: 16px;
  line-height: 1.65;

  color: #75849a;
}

.search-box {
  width: 100%;
  min-height: 66px;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 0 21px;

  background: #ffffff;

  border: 1px solid #d9e8f8;
  border-radius: 19px;

  color: #7b8ba0;

  box-shadow:
    0 8px 28px rgba(51, 116, 180, 0.07),
    0 0 0 4px rgba(78, 154, 241, 0.025);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.search-box:focus-within {
  border-color: #76b5ff;

  box-shadow:
    0 8px 30px rgba(51, 116, 180, 0.1),
    0 0 0 4px rgba(63, 142, 236, 0.08);
}

.search-box input {
  width: 100%;

  border: 0;
  outline: 0;

  background: transparent;

  font-size: 16px;

  color: #263247;
}

.search-box input::placeholder {
  color: #a4afbd;
}

.location-selector {
  margin-top: 16px;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 11px 14px;

  border: 1px solid #dceaf8;
  border-radius: 12px;

  background: #eef7ff;

  color: #357ac7;

  font-size: 13px;
  font-weight: 600;
}

.location-arrow {
  margin-left: 4px;

  color: #7b9ac0;
}

/* =================================
   QUICK CATEGORIES
   ================================= */

.quick-section {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 660px;

  margin: 48px auto 0;
}

.quick-heading h3 {
  margin: 0 0 15px;

  font-size: 16px;
  font-weight: 650;

  color: #273349;
}

.quick-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 11px;
}

.quick-card {
  min-height: 105px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 10px;

  border: 1px solid #e0ebf6;
  border-radius: 17px;

  background: rgba(255, 255, 255, 0.92);

  color: #263247;

  box-shadow: 0 5px 18px rgba(40, 95, 145, 0.045);

  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.quick-card:hover {
  transform: translateY(-2px);

  border-color: #bcdcff;

  box-shadow: 0 9px 25px rgba(40, 95, 145, 0.08);
}

.quick-icon {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background: #eaf5ff;

  color: #287ce9;
}

.quick-icon.more {
  background: #f1f6fb;
  color: #718198;
}

.quick-card > span:last-child {
  font-size: 12px;
  font-weight: 600;
}

/* =================================
   BOTTOM NAV
   ================================= */

.bottom-nav {
  position: fixed;

  z-index: 50;

  left: 50%;
  bottom: 18px;

  transform: translateX(-50%);

  width: min(420px, calc(100% - 32px));

  min-height: 68px;

  display: flex;
  align-items: center;
  justify-content: space-around;

  padding: 7px 12px;

  background: rgba(255, 255, 255, 0.94);

  border: 1px solid #e2ebf4;
  border-radius: 22px;

  box-shadow:
    0 12px 35px rgba(42, 89, 132, 0.12),
    0 3px 10px rgba(42, 89, 132, 0.04);

  backdrop-filter: blur(18px);
}

.nav-item {
  min-width: 85px;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;

  padding: 7px 10px;

  border: 0;
  background: transparent;

  color: #8a97a8;

  font-size: 10px;
  font-weight: 600;
}

.nav-item.active {
  color: #287ce9;
}

.nav-item.active svg {
  stroke-width: 2.5;
}

/* =================================
   RESULTS
   ================================= */

.results-page,
.detail-page {
  min-height: 100vh;

  padding-bottom: 110px;
}

.results-header,
.detail-header {
  position: sticky;
  top: 0;

  z-index: 20;

  width: 100%;

  min-height: 76px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 12px max(18px, calc((100% - 920px) / 2));

  background: rgba(248, 251, 255, 0.92);

  border-bottom: 1px solid #e8eff6;

  backdrop-filter: blur(15px);
}

.results-search {
  flex: 1;

  min-height: 50px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 0 15px;

  background: #ffffff;

  border: 1px solid #dce8f4;
  border-radius: 15px;

  color: #77879a;
}

.results-search input {
  flex: 1;

  min-width: 0;

  border: 0;
  outline: 0;

  background: transparent;

  font-size: 15px;

  color: #253148;
}

.clear-search {
  width: 25px;
  height: 25px;

  border: 0;
  border-radius: 50%;

  background: #eef3f8;

  color: #7c8999;

  line-height: 1;
}

.results-content {
  width: 100%;
  max-width: 920px;

  margin: 0 auto;

  padding: 34px 22px 50px;
}

.results-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 30px;
}

.results-title h2 {
  margin: 0 0 6px;

  font-size: 27px;
  font-weight: 700;

  letter-spacing: -0.8px;

  color: #1d293d;
}

.results-title p {
  margin: 0;

  font-size: 13px;

  color: #8190a2;
}

.results-location {
  display: flex;
  align-items: center;
  gap: 5px;

  color: #287ce9;

  font-size: 13px;
  font-weight: 600;

  white-space: nowrap;
}

.result-section {
  margin-bottom: 30px;
}

.result-section h3 {
  margin: 0 0 13px;

  font-size: 14px;
  font-weight: 700;

  color: #4e5d71;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.result-card {
  min-height: 126px;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 15px;

  background: #ffffff;

  border: 1px solid #e2ebf4;
  border-radius: 19px;

  box-shadow: 0 4px 17px rgba(48, 97, 145, 0.035);

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    border-color 0.15s ease;
}

.result-card:hover {
  transform: translateY(-1px);

  border-color: #cfe2f5;

  box-shadow: 0 8px 25px rgba(48, 97, 145, 0.07);
}

.result-card.clickable {
  cursor: pointer;
}

.product-result-visual,
.service-result-visual {
  width: 76px;
  height: 76px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 17px;

  color: #277de9;
}

.product-result-visual {
  background: #edf6ff;
}

.service-result-visual {
  background: #eef9f5;

  color: #1b9b76;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-info h4 {
  margin: 0 0 3px;

  font-size: 16px;
  font-weight: 650;

  color: #263247;
}

.result-info .brand {
  margin: 0 0 6px;

  font-size: 12px;

  color: #8492a4;
}

.result-info > strong {
  display: block;

  margin-bottom: 8px;

  font-size: 17px;
  font-weight: 700;

  color: #172238;
}

.result-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 8px;

  color: #8592a2;

  font-size: 11px;
}

.status {
  font-weight: 700;
}

.status.available {
  color: #139267;
}

.status.pending {
  color: #dc8a20;
}

.result-business {
  padding: 0;

  border: 0;

  background: transparent;

  color: #748295;

  font-size: 11px;
}

.result-business:hover {
  color: #287ce9;
}

.result-meta span {
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.result-actions {
  display: flex;
  gap: 7px;
}

.icon-action {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #dce7f1;
  border-radius: 12px;

  background: #ffffff;

  color: #637287;
}

.icon-action.whatsapp {
  color: #159568;
  border-color: #ccecdf;
}

.rating {
  display: flex;
  align-items: center;
  gap: 4px;

  margin-bottom: 7px;

  color: #e49b24;

  font-size: 13px;
  font-weight: 700;
}

/* =================================
   DETAIL
   ================================= */

.detail-header {
  padding-left: max(18px, calc((100% - 760px) / 2));
  padding-right: max(18px, calc((100% - 760px) / 2));
}

.detail-header > span {
  flex: 1;

  font-size: 14px;
  font-weight: 650;

  color: #56657a;
}

.back-button {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border: 1px solid #e1eaf3;
  border-radius: 13px;

  background: #ffffff;

  color: #344258;

  box-shadow: 0 3px 12px rgba(50, 100, 145, 0.05);
}

.detail-content,
.business-page-content {
  width: 100%;
  max-width: 760px;

  margin: 0 auto;

  padding: 48px 22px 60px;
}

.detail-content {
  text-align: center;
}

.product-visual,
.service-visual,
.business-category-icon {
  width: 112px;
  height: 112px;

  margin: 0 auto 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 29px;
}

.product-visual {
  background:
    linear-gradient(145deg, #edf7ff, #e1f0ff);

  color: #287ce9;
}

.service-visual {
  background: #eaf9f4;

  color: #17936d;
}

.business-category-icon {
  background:
    linear-gradient(145deg, #edf7ff, #e2f1ff);

  color: #287ce9;
}

.detail-status {
  display: inline-flex;

  padding: 7px 11px;

  margin-bottom: 12px;

  border-radius: 9px;

  background: #e9f8f1;

  color: #138b63;

  font-size: 12px;
  font-weight: 700;
}

.detail-content h1,
.business-page-content h1 {
  margin: 0;

  font-size: clamp(29px, 6vw, 41px);

  font-weight: 720;

  letter-spacing: -1.5px;

  color: #182337;
}

.detail-brand {
  margin: 7px 0 0;

  font-size: 16px;

  color: #8290a1;
}

.detail-price {
  margin-top: 21px;

  font-size: 32px;

  font-weight: 750;

  letter-spacing: -1px;

  color: #172238;
}

.updated {
  margin: 8px 0 0;

  font-size: 11px;

  color: #99a5b4;
}

.detail-divider {
  width: 100%;
  height: 1px;

  margin: 31px 0;

  background: #e7eef5;
}

.business-detail {
  text-align: left;
}

.business-name-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #263247;

  font-size: 20px;
  font-weight: 700;
}

.business-name-button:hover {
  color: #287ce9;
}

.business-detail h2 {
  margin: 0 0 20px;

  font-size: 21px;
  font-weight: 700;

  color: #263247;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 5px;

  margin: 9px 0 20px;

  color: #e59c22;

  font-size: 13px;
  font-weight: 700;
}

.detail-row,
.business-info-row {
  display: flex;
  align-items: flex-start;

  gap: 12px;

  margin-top: 17px;

  color: #287ce9;
}

.detail-row div,
.business-info-row div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.detail-row strong,
.business-info-row strong {
  color: #344258;

  font-size: 13px;
}

.detail-row span,
.business-info-row span {
  color: #8290a1;

  font-size: 13px;
}

.stock {
  margin-top: 20px;

  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 10px 12px;

  border-radius: 10px;

  background: #eaf8f2;

  color: #138d65;

  font-size: 12px;
  font-weight: 650;
}

.stock span {
  color: #18a16f;
}

.detail-actions,
.business-actions {
  display: flex;
  gap: 10px;

  margin-top: 31px;
}

.primary-action,
.secondary-action {
  min-height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 0 19px;

  border-radius: 14px;

  font-size: 13px;
  font-weight: 700;
}

.primary-action {
  flex: 1;

  border: 0;

  background: linear-gradient(
    135deg,
    #2c82f3,
    #2472df
  );

  color: #ffffff;

  box-shadow:
    0 8px 20px rgba(43, 126, 236, 0.2);
}

.secondary-action {
  flex: 1;

  border: 1px solid #d8e6f3;

  background: #ffffff;

  color: #405069;
}

/* =================================
   BUSINESS
   ================================= */

.business-page-content {
  text-align: center;
}

.business-category {
  margin: 0 0 9px;

  color: #287ce9;

  font-size: 12px;
  font-weight: 750;

  letter-spacing: 0.4px;
}

.business-page-content h1 {
  font-size: clamp(28px, 5vw, 39px);
}

.business-rating {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  margin-top: 11px;

  color: #e49b24;

  font-size: 13px;
}

.business-rating span {
  margin-left: 2px;

  color: #8794a4;
}

.business-info {
  max-width: 620px;

  margin: 30px auto 0;

  padding: 20px;

  background: #ffffff;

  border: 1px solid #e1eaf3;
  border-radius: 17px;

  text-align: left;

  box-shadow: 0 4px 18px rgba(40, 90, 140, 0.035);
}

.business-actions {
  max-width: 620px;

  margin: 12px auto 0;
}

.business-products {
  max-width: 620px;

  margin: 38px auto 0;

  text-align: left;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 13px;
}

.section-heading h2 {
  margin: 0;

  font-size: 17px;
  font-weight: 700;

  color: #344258;
}

.section-heading span {
  min-width: 22px;
  height: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #edf5fd;

  color: #5b7390;

  font-size: 11px;
  font-weight: 700;
}

.business-product-list {
  display: flex;
  flex-direction: column;

  gap: 9px;
}

.business-product {
  display: flex;
  align-items: center;

  gap: 13px;

  padding: 13px;

  background: #ffffff;

  border: 1px solid #e2ebf4;
  border-radius: 15px;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

.business-product:hover {
  transform: translateY(-1px);

  box-shadow: 0 6px 20px rgba(45, 95, 140, 0.06);
}

.small-product-icon {
  width: 47px;
  height: 47px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background: #edf6ff;

  color: #287ce9;
}

.business-product-info {
  flex: 1;
}

.business-product h3 {
  margin: 0 0 3px;

  font-size: 14px;
  font-weight: 650;

  color: #344258;
}

.business-product p {
  margin: 0 0 4px;

  font-size: 11px;

  color: #94a0ae;
}

.business-product strong {
  font-size: 14px;

  color: #263247;
}

.product-status {
  font-size: 10px;
  font-weight: 700;

  color: #149268;

  white-space: nowrap;
}

.service-rating {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-top: 17px;

  color: #e49b24;
}

.service-rating strong {
  font-size: 16px;
}

.service-rating span {
  color: #8995a5;

  font-size: 12px;
}

.service-list {
  margin-top: 30px;

  text-align: left;
}

.service-list h3 {
  margin: 0 0 12px;

  font-size: 16px;
  font-weight: 700;

  color: #344258;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;
}

.service-tags span {
  padding: 8px 11px;

  border: 1px solid #e1eaf3;
  border-radius: 10px;

  background: #ffffff;

  color: #5e6e83;

  font-size: 12px;
}

/* =================================
   EMPTY
   ================================= */

.empty-state {
  padding: 65px 20px;

  text-align: center;
}

.empty-icon {
  width: 68px;
  height: 68px;

  margin: 0 auto 16px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: #edf6ff;

  color: #287ce9;
}

.empty-state h3 {
  margin: 0 0 7px;

  font-size: 19px;
  font-weight: 700;

  color: #344258;
}

.empty-state p {
  margin: 0;

  color: #8a97a7;

  font-size: 13px;
}

/* =================================
   MOBILE
   ================================= */

@media (max-width: 650px) {
  .home {
    padding: 25px 17px 115px;
  }

  .hero-search {
    margin-top: 72px;
  }

  .hero-search h2 {
    font-size: 36px;
  }

  .hero-description {
    font-size: 14px;
  }

  .quick-section {
    margin-top: 39px;
  }

  .quick-grid {
    gap: 8px;
  }

  .quick-card {
    min-height: 96px;
  }

  .quick-icon {
    width: 43px;
    height: 43px;
  }

  .quick-card > span:last-child {
    font-size: 11px;
  }

  .results-header,
  .detail-header {
    padding: 11px 14px;
  }

  .results-content {
    padding: 27px 14px 45px;
  }

  .results-title {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .results-title h2 {
    font-size: 23px;
  }

  .result-card {
    align-items: flex-start;
    gap: 11px;
    padding: 12px;
  }

  .product-result-visual,
  .service-result-visual {
    width: 57px;
    height: 57px;
    border-radius: 14px;
  }

  .result-info h4 {
    font-size: 14px;
  }

