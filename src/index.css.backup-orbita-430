  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;
}

.splash-loading {
  position: absolute;

  bottom: 13%;

  display: flex;
  align-items: center;
  gap: 6px;

  animation: splashLoading 5s ease forwards;
}

.splash-loading span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #287ce9;

  animation: splashDots 1s ease-in-out infinite;
}

