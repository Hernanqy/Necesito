import { useEffect, useMemo, useState } from 'react'
import './App.css'

type Product = {
  id: number
  name: string
  brand: string
  price: number
  status: string
  business: string
  distance: number
  address: string
  hours: string
  updated: string
}

type Service = {
  id: number
  name: string
  specialty: string
  rating: number
  status: string
  business: string
  distance: number
  address: string
  hours: string
  updated: string
}

const products: Product[] = [
  {
    id: 1,
    name: 'Llave francesa 12"',
    brand: 'Stanley',
    price: 25000,
    status: 'Disponible',
    business: 'Ferretería Todo Casa',
    distance: 1.2,
    address: 'Rivadavia 3225, Olavarría',
    hours: 'Lunes a sábados 8:30 a 19:00',
    updated: 'hace 2 horas',
  },
  {
    id: 2,
    name: 'Llave francesa 12"',
    brand: 'Bremen',
    price: 23500,
    status: 'Consultar disponibilidad',
    business: 'Ferretería Galarza',
    distance: 2.1,
    address: 'España 3103, Olavarría',
    hours: 'Lunes a sábados 8:30 a 19:30',
    updated: 'hace 1 día',
  },
  {
    id: 3,
    name: 'Llave combinada',
    brand: 'Bahco',
    price: 18500,
    status: 'Disponible',
    business: 'Ferretería Industrial',
    distance: 2.4,
    address: 'Alberdi 2800, Olavarría',
    hours: 'Lunes a viernes 8:00 a 18:00',
    updated: 'hace 3 horas',
  },
  {
    id: 4,
    name: 'Taladro percutor',
    brand: 'Bosch',
    price: 185000,
    status: 'Disponible',
    business: 'Ferretería Todo Casa',
    distance: 1.2,
    address: 'Rivadavia 3225, Olavarría',
    hours: 'Lunes a sábados 8:30 a 19:00',
    updated: 'hace 3 horas',
  },
]

const services: Service[] = [
  {
    id: 1,
    name: 'Juan Pérez',
    specialty: 'Plomería general',
    rating: 4.8,
    status: 'Disponible hoy',
    business: 'Juan Pérez Plomería',
    distance: 1.4,
    address: 'Olavarría',
    hours: 'Lunes a sábados 8:00 a 20:00',
    updated: 'hace 1 hora',
  },
  {
    id: 2,
    name: 'Servicios López',
    specialty: 'Plomería y gas',
    rating: 4.6,
    status: 'Disponible hoy',
    business: 'Servicios López',
    distance: 2.1,
    address: 'Olavarría',
    hours: 'Lunes a sábados 8:00 a 19:00',
    updated: 'hace 4 horas',
  },
]

function normalize(text: string) {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
}

function formatPrice(price: number) {
  return new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0,
  }).format(price)
}

function icon(type: string) {
  if (type === 'search') return '⌕'
  if (type === 'location') return '⌖'
  if (type === 'back') return '←'
  if (type === 'heart') return '♡'
  if (type === 'bell') return '♧'
  if (type === 'store') return '▣'
  if (type === 'wrench') return '⚒'
  if (type === 'water') return '♢'
  if (type === 'electric') return 'ϟ'
  if (type === 'paint') return '◈'
  return '•'
}

function App() {
  const [showSplash, setShowSplash] = useState(true)
  const [isSearching, setIsSearching] = useState(false)
  const [search, setSearch] = useState('')
  const [query, setQuery] = useState('')
  const [view, setView] = useState<'home' | 'results' | 'product' | 'service' | 'business'>('home')
  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null)
  const [selectedService, setSelectedService] = useState<Service | null>(null)
  const [selectedBusiness, setSelectedBusiness] = useState<string | null>(null)

  useEffect(() => {
    const timer = window.setTimeout(() => {
      setShowSplash(false)
    }, 6000)

    return () => window.clearTimeout(timer)
  }, [])

  const filteredProducts = useMemo(() => {
    if (!query.trim()) return []

    const q = normalize(query)

    return products.filter((product) =>
      normalize(
        `${product.name} ${product.brand} ${product.business}`,
      ).includes(q),
    )
  }, [query])

  const filteredServices = useMemo(() => {
    if (!query.trim()) return []

    const q = normalize(query)

    const aliases: Record<string, string> = {
      plomero: 'plomeria',
      plomera: 'plomeria',
      gasista: 'gas',
      electricista: 'electricidad',
      pintor: 'pintura',
    }

    const searchTerm = aliases[q] || q

    return services.filter((service) =>
      normalize(
        `${service.name} ${service.specialty} ${service.business}`,
      ).includes(searchTerm),
    )
  }, [query])

  if (showSplash) {
    return (
      <div className="splash-screen">

        <div className="splash-floating-icons" aria-hidden="true">
          <img className="splash-icon splash-icon-1" src="/plomero.png" alt="" />
          <img className="splash-icon splash-icon-2" src="/electricista.png" alt="" />
          <img className="splash-icon splash-icon-3" src="/carpintero.png" alt="" />
          <img className="splash-icon splash-icon-4" src="/pintor.png" alt="" />
          <img className="splash-icon splash-icon-5" src="/mecanico.png" alt="" />
          <img className="splash-icon splash-icon-6" src="/herrero.png" alt="" />
                  <img
            className="splash-special-icon splash-herramientas"
            src="/herramientas.png"
            alt=""
          />

          <img
            className="splash-special-icon splash-maquina"
            src="/maquinaDeCoser.png"
            alt=""
          />
</div>

        <div className="splash-logo">
          <img
            src="/logo-necesito.png"
            alt="Necesito..."
          />
        </div>

        <div className="splash-dots">
          <span />
          <span />
          <span />
        </div>
      </div>
    )
  }

  async function performSearch(value = search) {
    const clean = value.trim()

    if (!clean || isSearching) return

    setIsSearching(true)

    try {
      const response = await fetch('/api/interpretar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texto: clean }),
      })

      if (!response.ok) throw new Error('AI search failed')

      const interpreted = await response.json()
      const interpretedTerm = typeof interpreted?.termino === 'string' ? interpreted.termino.trim() : ''

      setSearch(clean)
      setQuery(interpretedTerm || clean)
      setView('results')
      setSelectedProduct(null)
      setSelectedService(null)
      setSelectedBusiness(null)
    } catch (error) {
      console.error('AI search error:', error)
      setSearch(clean)
      setQuery(clean)
      setView('results')
      setSelectedProduct(null)
      setSelectedService(null)
      setSelectedBusiness(null)
    } finally {
      setIsSearching(false)
    }
  }

  function goHome() {
    setSearch('')
    setQuery('')
    setView('home')
    setSelectedProduct(null)
    setSelectedService(null)
    setSelectedBusiness(null)
  }

  function openProduct(product: Product) {
    setSelectedProduct(product)
    setView('product')
  }

  function openService(service: Service) {
    setSelectedService(service)
    setView('service')
  }

  function openBusiness(name: string) {
    setSelectedBusiness(name)
    setView('business')
  }

  function backToResults() {
    setView('results')
    setSelectedProduct(null)
    setSelectedService(null)
    setSelectedBusiness(null)
  }

  if (view === 'product' && selectedProduct) {
    return (
      <div className="app">
        <header className="topbar">
          <button className="round-button" onClick={backToResults}>
            {icon('back')}
          </button>
          <span>Producto</span>
          <button className="round-button">{icon('heart')}</button>
        </header>

        <main className="detail-page">
          <div className="product-large-icon">
            {icon('wrench')}
          </div>

          <div className="available-badge">
            {selectedProduct.status}
          </div>

          <h1>{selectedProduct.name}</h1>

          <p className="detail-brand">
            {selectedProduct.brand}
          </p>

          <div className="detail-price">
            {formatPrice(selectedProduct.price)}
          </div>

          <p className="updated">
            Actualizado {selectedProduct.updated}
          </p>

          <div className="separator" />

          <button
            className="business-link"
            onClick={() =>
              openBusiness(selectedProduct.business)
            }
          >
            {icon('store')} {selectedProduct.business}
          </button>

          <div className="detail-info">
            <p>
              <strong>{selectedProduct.distance} km</strong>
              <br />
              {selectedProduct.address}
            </p>

            <p>
              <strong>Horario</strong>
              <br />
              {selectedProduct.hours}
            </p>
          </div>

          <div className="actions">
            <button className="primary-button">
              {icon('location')} Cómo llegar
            </button>

            <button className="secondary-button">
              WhatsApp
            </button>
          </div>
        </main>

        <BottomNavigation />
      </div>
    )
  }

  if (view === 'service' && selectedService) {
    return (
      <div className="app">
        <header className="topbar">
          <button className="round-button" onClick={backToResults}>
            {icon('back')}
          </button>
          <span>Servicio</span>
          <button className="round-button">{icon('heart')}</button>
        </header>

        <main className="detail-page">
          <div className="service-large-icon">
            {icon('wrench')}
          </div>

          <div className="available-badge">
            {selectedService.status}
          </div>

          <h1>{selectedService.name}</h1>

          <p className="detail-brand">
            {selectedService.specialty}
          </p>

          <div className="service-rating">
            ★ {selectedService.rating}
            <span>Muy bien valorado</span>
          </div>

          <p className="updated">
            Actualizado {selectedService.updated}
          </p>

          <div className="separator" />

          <div className="detail-info left">
            <p>
              <strong>{selectedService.distance} km</strong>
              <br />
              {selectedService.address}
            </p>

            <p>
              <strong>Horario</strong>
              <br />
              {selectedService.hours}
            </p>
          </div>

          <div className="actions">
            <button className="primary-button">
              WhatsApp
            </button>

            <button className="secondary-button">
              Llamar
            </button>
          </div>
        </main>

        <BottomNavigation />
      </div>
    )
  }

  if (view === 'business' && selectedBusiness) {
    const businessProducts = products.filter(
      (product) => product.business === selectedBusiness,
    )

    return (
      <div className="app">
        <header className="topbar">
          <button className="round-button" onClick={backToResults}>
            {icon('back')}
          </button>
          <span>Comercio</span>
          <button className="round-button">{icon('heart')}</button>
        </header>

        <main className="business-page">
          <div className="business-icon">
            {icon('store')}
          </div>

          <p className="category-label">
            Ferretería
          </p>

          <h1>{selectedBusiness}</h1>

          <div className="business-rating">
            ★ 4.6 <span>Valoración</span>
          </div>

          <div className="business-card">
            <p>
              {icon('location')}
              <span>
                <strong>1.2 km</strong>
                <br />
                Rivadavia 3225, Olavarría
              </span>
            </p>

            <p>
              <span className="info-symbol">◷</span>
              <span>
                <strong>Horario</strong>
                <br />
                Lunes a sábados 8:30 a 19:00
              </span>
            </p>
          </div>

          <div className="actions">
            <button className="primary-button">
              {icon('location')} Cómo llegar
            </button>

            <button className="secondary-button">
              WhatsApp
            </button>
          </div>

          {businessProducts.length > 0 && (
            <section className="business-products">
              <h2>Productos</h2>

              {businessProducts.map((product) => (
                <button
                  className="business-product"
                  key={product.id}
                  onClick={() => openProduct(product)}
                >
                  <span className="small-icon">
                    {icon('wrench')}
                  </span>

                  <span className="product-text">
                    <strong>{product.name}</strong>
                    <small>{product.brand}</small>
                    <b>{formatPrice(product.price)}</b>
                  </span>

                  <span className="green-text">
                    Disponible
                  </span>
                </button>
              ))}
            </section>
          )}
        </main>

        <BottomNavigation />
      </div>
    )
  }

  if (view === 'results') {
    const total =
      filteredProducts.length + filteredServices.length

    return (
      <div className="app">
        <header className="results-header">
          <button className="round-button" onClick={goHome}>
            {icon('back')}
          </button>

          <div className="results-search">
            <span>{icon('search')}</span>

            <input
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              onKeyDown={(event) => {
                if (event.key === 'Enter') {
                  performSearch()
                }
              }}
            />
          </div>

          <button className="round-button">
            {icon('bell')}
          </button>
        </header>

        <main className="results-page">
          <div className="results-heading">
            <div>
              <h1>
                {total > 0
                  ? 'Encontramos opciones'
                  : 'No encontramos resultados'}
              </h1>

              <p>
                {total > 0
                  ? `${total} opciones cerca tuyo`
                  : 'Probá con otra búsqueda'}
              </p>
            </div>

            <span className="result-location">
              {icon('location')} Olavarría
            </span>
          </div>

          {filteredProducts.length > 0 && (
            <section className="result-section">
              <h2>Productos</h2>

              {filteredProducts.map((product) => (
                <article
                  className="result-card"
                  key={product.id}
                  onClick={() => openProduct(product)}
                >
                  <div className="result-icon">
                    {icon('wrench')}
                  </div>

                  <div className="result-content">
                    <h3>{product.name}</h3>
                    <p>{product.brand}</p>
                    <strong>
                      {formatPrice(product.price)}
                    </strong>

                    <div className="meta">
                      <span
                        className={
                          product.status === 'Disponible'
                            ? 'green-text'
                            : 'orange-text'
                        }
                      >
                        {product.status}
                      </span>

                      <button
                        onClick={(event) => {
                          event.stopPropagation()
                          openBusiness(product.business)
                        }}
                      >
                        {product.business}
                      </button>

                      <span>
                        {icon('location')}
                        {product.distance} km
                      </span>
                    </div>
                  </div>

                  <div className="card-actions">
                    <button
                      onClick={(event) =>
                        event.stopPropagation()
                      }
                    >
                      WhatsApp
                    </button>

                    <button
                      onClick={(event) =>
                        event.stopPropagation()
                      }
                    >
                      {icon('location')}
                    </button>
                  </div>
                </article>
              ))}
            </section>
          )}

          {filteredServices.length > 0 && (
            <section className="result-section">
              <h2>Servicios</h2>

              {filteredServices.map((service) => (
                <article
                  className="result-card"
                  key={service.id}
                  onClick={() => openService(service)}
                >
                  <div className="service-result-icon">
                    {icon('wrench')}
                  </div>

                  <div className="result-content">
                    <h3>{service.name}</h3>
                    <p>{service.specialty}</p>

                    <div className="service-rating small">
                      ★ {service.rating}
                    </div>

                    <div className="meta">
                      <span className="green-text">
                        {service.status}
                      </span>

                      <span>{service.business}</span>

                      <span>
                        {icon('location')}
                        {service.distance} km
                      </span>
                    </div>
                  </div>

                  <div className="card-actions">
                    <button
                      onClick={(event) =>
                        event.stopPropagation()
                      }
                    >
                      WhatsApp
                    </button>
                  </div>
                </article>
              ))}
            </section>
          )}

          {total === 0 && (
            <div className="empty-state">
              <div className="empty-icon">
                {icon('search')}
              </div>

              <h2>Probemos otra búsqueda</h2>

              <p>
                Podés buscar un producto, un comercio o
                un servicio.
              </p>
            </div>
          )}
        </main>

        <BottomNavigation />
      </div>
    )
  }

  return (
    <div className="app">
      <main className="home">
        <header className="home-header">
          <div className="mini-brand">
            <img
              src="/logo-necesito.png"
              alt="Necesito..."
            />
          </div>

          <button className="round-button">
            {icon('bell')}
          </button>
        </header>

        <section className="hero">
          <p className="eyebrow">OLAVARRÍA</p>

          <h1>
            ¿Qué <span>necesitás?</span>
          </h1>

          <p className="hero-text">
            Encontrá productos y servicios
            <br />
            cerca tuyo en segundos.
          </p>

          <div className="main-search">
            <span>{icon('search')}</span>

            <input
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              onKeyDown={(event) => {
                if (event.key === 'Enter') {
                  performSearch()
                }
              }}
              placeholder="Escribí lo que buscás..."
            />
          </div>

          <button className="location-button">
            {icon('location')}
            Olavarría
            <span>⌄</span>
          </button>
        </section>

        <section className="quick-section">
          <h2>Buscá algo rápido</h2>

          <div className="quick-grid">
            <button
              onClick={() => performSearch('llave')}
            >
              <span className="quick-icon">
                {icon('wrench')}
              </span>
              Ferretería
            </button>

            <button
              onClick={() => performSearch('plomero')}
            >
              <span className="quick-icon">
                {icon('water')}
              </span>
              Plomería
            </button>

            <button
              onClick={() =>
                performSearch('electricista')
              }
            >
              <span className="quick-icon">
                {icon('electric')}
              </span>
              Electricidad
            </button>

            <button
              onClick={() => performSearch('pintor')}
            >
              <span className="quick-icon">
                {icon('paint')}
              </span>
              Pintura
            </button>

            <button
              onClick={() => performSearch('taladro')}
            >
              <span className="quick-icon">
                {icon('wrench')}
              </span>
              Herramientas
            </button>

            <button
              onClick={() => performSearch('plomero')}
            >
              <span className="quick-icon more">
                +
              </span>
              Ver más
            </button>
          </div>
        </section>
      </main>

      <BottomNavigation />
    </div>
  )
}

function BottomNavigation() {
  return (
    <nav className="bottom-navigation">
      <button className="active">
        {icon('search')}
        <span>Buscar</span>
      </button>

      <button>
        {icon('heart')}
        <span>Favoritos</span>
      </button>

      <button>
        <span className="nav-user">○</span>
        <span>Perfil</span>
      </button>
    </nav>
  )
}

export default App